@model ProductSizeListViewModel

    <div>
        <div class="mb-3">
            <a asp-controller="ProductSizes" asp-action="Create" asp-route-productId="@Model.ProductId" class="btn btn-primary">
                Create
            </a>
        </div>
        
        <table class="table">
            <thead>
            <tr>
                <th>Id</th>
                <th>Length</th>
                <th>Height</th>
                <th>Width</th>
            </tr>
            </thead>

            <tbody>
                @foreach (var productSize in Model.ProductSizes)
                {
                    <tr>
                        <td>@productSize.Size.Id</td>
                        <td>@productSize.Size.Length</td>
                        <td>@productSize.Size.Height</td>
                        <td>@productSize.Size.Width</td>
                    </tr>

                    <td>
                        <form asp-controller="ProductSizes"
                        asp-action="Delete"
                        asp-route-productId="@productSize.ProductId"
                        asp-route-sizeId="@productSize.SizeId">
                        <button type="submit" class="btn btn-danger">
                            Delete
                        </button>
                    
                        </form>
                    </td>
                }
            </tbody>
        </table>
    </div>