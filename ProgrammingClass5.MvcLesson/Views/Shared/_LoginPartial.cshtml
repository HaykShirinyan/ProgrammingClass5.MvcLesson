@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject ProgrammingClass5.MvcLesson.Data.ApplicationDbContext DbContext

@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);

    var cartQuantity = await DbContext
        .ShoppingCartProducts
        .CountAsync(cartProduct => cartProduct.UserId == userId);
}

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link text-dark position-relative" asp-controller="ShoppingCart" asp-action="Index">
            Cart

            <span class="position-absolute cart-quantity start-100 translate-middle badge rounded-pill bg-danger">
                @cartQuantity
                <span class="visually-hidden">Cart quantity</span>
            </span>
        </a>
    </li>
    <li class="nav-item">
        <a  class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Hello @User.Identity?.Name!</a>
    </li>
    <li class="nav-item">
        <form  class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button  type="submit" class="nav-link btn btn-link text-dark">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
