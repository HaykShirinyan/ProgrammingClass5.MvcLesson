@model List<CartItem>

<h2>Shopping Cart</h2>

<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Unit Price</th>
            <th>Quantity</th>
            <th>Total</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Product.Name</td>
                <td>@item.Product.UnitPrice</td>
                <td>@item.Quantity</td>
                <td>@(item.Product.UnitPrice * item.Quantity)</td>
                <td>
                    <form asp-controller="Products" asp-action="RemoveFromCart" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="cartItemId" value="@item.Id" />
                        <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to remove this item?');">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    <h3>Total: @(Model.Sum(i => i.Product.UnitPrice * i.Quantity))</h3>
</div>
